# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库。

# LLM provider（OpenAI 兼容 Chat Completions / Responses API）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_MAX_OUTPUT_TOKENS=8000
TRADEMIND_PYTHON=~/Desktop/TradeMind_Agent/.venv/bin/python

# QVeris（Serenity / 财报等非持仓、非价格数据）
QVERIS_API_KEY=sk-your-qveris-key-here
QVERIS_BASE_URL=https://qveris.ai/api/v1

# 可选
# IBKR_SCRIPTS_DIR=~/Desktop/ibkr-options-assistant/scripts
# IBKR_PYTHON=~/Desktop/ibkr-options-assistant/.venv/bin/python
# TRADEMIND_DB=~/Desktop/TradeMind_Agent/agent/db/trademind.db
# TRADEMIND_ROOT=~/Desktop/TradeMind_Agent           # Dashboard API 用于定位 agent/db/gex/ 快照目录
# GEX_TICKERS=SPY,QQQ                               # EOD GEX 快照覆盖的标的（逗号分隔）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
